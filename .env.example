# Скопируйте в .env и подставьте значения из OAuth-приложения osu!
# Callback URL на osu! = VITE_OSU_REDIRECT_URI (тот же порт, что у npm run dev)
VITE_OSU_CLIENT_ID=
VITE_OSU_REDIRECT_URI=http://localhost:5173/

# На VPS дублируй Client ID сюда (обмен токена; надёжнее, чем только VITE_* при systemd)
# OSU_CLIENT_ID=

OSU_CLIENT_SECRET=

# Необязательно: свой префикс osu API (по умолчанию /api/osu-v2 — прокси Vite/nginx)
# VITE_OSU_API_BASE=/api/osu-v2

# VITE_DEV_PORT=5173

# Персистентный граф «Весь мир» (SQLite). Файл создаётся автоматически.
# WORLD_DATABASE_PATH=data/world.sqlite
# Порт API мира (должен совпадать с прокси в vite; по умолчанию 8787)
# WORLD_API_PORT=8787
