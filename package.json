{
  "name": "osu-friends-graph",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,vite -c blue,green \"npm run dev:api\" \"vite\"",
    "dev:api": "tsx watch server/worldApi.ts",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start:api": "tsx server/worldApi.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "d3-force": "^3.0.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.10.1",
    "concurrently": "^9.1.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
